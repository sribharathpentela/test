# Copy to `.env` and fill in. `.env` is gitignored; never commit real tokens.
#
# Names are ALL-CAPS on purpose: environment variables are case-sensitive on
# Linux (VDI/CI) and case-insensitive on Windows.

GROQ_API_KEY=

# --- GitHub endpoint ---------------------------------------------------------
# GitHub.com:               https://api.github.com
# GitHub Enterprise Server: https://<ghes-host>/api/v3
GIT_API_BASE_URL=https://api.github.com
GIT_ORG=
GIT_DEFAULT_BRANCH=main

# --- Central IaC modules repo (READ ONLY -- DA must never write here) --------
# PAT: Metadata read, Contents read.
GIT_MODULES_REPO=
GIT_MODULES_PAT=

# --- Application IaC monorepo (branch, commit and PR at Step 5) --------------
# PAT: Metadata read, Contents read+write, Pull requests read+write.
GIT_APP_REPO=
GIT_APP_PAT=

# --- Section C (config changes) -------------------------------------
# The GitOps repo holding the Kubernetes/Kustomize manifests. Either
# "owner/repo", or a bare repo name that will be qualified with GIT_ORG.
GIT_GITOPS_REPO=
# Read-only is sufficient: the agent has no write path to any repo.
GIT_GITOPS_PAT=
