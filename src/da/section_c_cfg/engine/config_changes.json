    {
      "id": 9,
      "request": "Service port change",
      "human_must_provide": [
        "Service",
        "Environment",
        "Desired service port"
      ],
      "pre_checks": [
        "No-op check",
        "Port is within valid range 1-65535",
        "Target Service exists in the repo (base or overlay)",
        "If the Service has multiple ports, the intended Service port must be explicitly identified",
        "Base vs overlay checked",
        "For the selected Service port, resolve all matching VirtualService routes in the environment ingress configuration",
        "Current Service port must match the corresponding VirtualService destination port before applying the change",
        "If the Service port and VirtualService destination port are already inconsistent, stop for review and do not automatically correct the existing mismatch"
      ],
      "target_fields": [
        {
          "file": "service.yaml",
          "in": "base",
          "fields": {
            "service_port": [
              "spec",
              "ports",
              "<selected_index>",
              "port"
            ]
          }
        },
        {
          "file": "cf-frontend-core-ingress-public.yaml",
          "in": "clusters/<cluster>/<environment>-ingress",
          "kind": "VirtualService",
          "fields": {
            "destination_service_port": [
              "spec",
              "http",
              "<matching_route_index>",
              "route",
              "<matching_destination_index>",
              "destination",
              "port",
              "number"
            ]
          }
        }
      ]
    },
