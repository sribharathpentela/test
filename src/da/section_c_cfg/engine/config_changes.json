        "Desired CPU value",
        "Request or limit"
      ],
      "pre_checks": [
        "No-op check",
        "Valid Kubernetes CPU quantity",
        "CPU request <= CPU limit",
        "Target exists in the repo (base or overlay)",
        "Base vs overlay checked"
      ],
      "target_fields": [
        {
          "file": "deployment-v1.yaml",
          "in": "base",
          "fields": {
            "cpu_request": [
              "spec",
              "template",
              "spec",
              "containers",
              0,
              "resources",
              "requests",
              "cpu"
            ],
            "cpu_limit": [
              "spec",
              "template",
              "spec",
              "containers",
              0,
              "resources",
              "limits",
              "cpu"
            ]
          }
        }
      ]
    },
