{
  "instructions_for_agent": "When a user requests a config change: 1) Find the matching entry below by 'request' name. 2) Ask the user for everything listed in 'human_must_provide' if not already given. 3) Look up or discover everything listed in 'agent_must_identify' from the repository or live environment. 4) Run every item in 'pre_checks' before making the change. 5) When 'target_fields' is present, use only the specified file and exact YAML field paths for reading and mutation. 6) Do not use LLM-based discovery to select the mutation target when 'target_fields' is present. 7) If any pre-check fails, log that item to gap_register.json and skip only that item.",
  "environment_clusters": {
    "dev": "aks-catalyst-dev-eastus-001"
  },
  "config_changes": [
    {
      "id": 1,
      "request": "Replica count change",
      "human_must_provide": [
        "Service",
        "Environment",
        "Desired replica value",
        "Which field: minReplicas, maxReplicas, or both"
      ],
      "pre_checks": [
        "No-op check (current vs desired value)",
        "Integer/range valid",
        "min <= max"
      ],
      "target_fields": [
        {
          "file": "hpa-v1.yaml",
          "in": "base",
          "fields": {
            "minReplicas": [
              "spec",
              "minReplicas"
            ],
            "maxReplicas": [
              "spec",
              "maxReplicas"
            ]
          }
        }
      ]
    },
    {
